# Keep signed and hashed bytes exact. HMAC-SHA256 webhook signatures and HW-JCS digests are
# computed over raw bytes, and core.autocrlf=true on Windows would rewrite LF to CRLF on checkout.
fixtures/** -text
*.json -text
*.jsonl -text

# The generated console data is compared byte for byte with a fresh export; keep it LF.
web/console/data/console_data.js -text
