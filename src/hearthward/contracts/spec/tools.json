[
  {
    "_meta": {
      "hearthward/class": "S+"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Who came to the door recently, from the household's door cameras. Read-only.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "window": {
          "enum": [
            "last_15_min",
            "last_hour",
            "today"
          ],
          "type": "string"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "name": "get_door_activity",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "enum": [
            "live",
            "synthetic"
          ],
          "type": "string"
        },
        "summary": {
          "maxLength": 200,
          "type": "string"
        },
        "visits": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cameras": {
                "items": {
                  "maxLength": 40,
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              "first_seen_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "last_seen_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "open": {
                "type": "boolean"
              },
              "trigger": {
                "enum": [
                  "motion_human",
                  "motion_other",
                  "button_press"
                ],
                "type": "string"
              },
              "vehicle_seen": {
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ],
                "type": "string"
              },
              "visit_id": {
                "pattern": "^vis_[0-9A-HJKMNP-TV-Z]{26}$",
                "type": "string"
              },
              "visitor": {
                "enum": [
                  "known_circle",
                  "known_vendor",
                  "unknown"
                ],
                "type": "string"
              }
            },
            "required": [
              "visit_id",
              "first_seen_ms",
              "last_seen_ms",
              "trigger",
              "visitor",
              "open"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "visits",
        "summary",
        "data_origin"
      ],
      "type": "object"
    },
    "title": "Door activity"
  },
  {
    "_meta": {
      "hearthward/class": "S+"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Get a second opinion on someone at the door or on the phone. Every argument is the customer's report of what the visitor claimed; none of it is treated as verified.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "asked_secrecy": {
          "type": "boolean"
        },
        "claimed_identity_name": {
          "maxLength": 60,
          "type": "string"
        },
        "claimed_organization": {
          "maxLength": 80,
          "type": "string"
        },
        "claimed_purpose": {
          "enum": [
            "utility",
            "repair",
            "delivery",
            "government",
            "bank",
            "charity",
            "family_member",
            "other"
          ],
          "type": "string"
        },
        "claimed_relationship": {
          "enum": [
            "none",
            "grandchild",
            "child",
            "other_family",
            "official",
            "other"
          ],
          "type": "string"
        },
        "payment_requested": {
          "enum": [
            "none",
            "cash",
            "gift_card",
            "wire",
            "crypto",
            "check",
            "card",
            "unknown"
          ],
          "type": "string"
        },
        "urgency_claimed": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "assess_visitor",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "enum": [
            "live",
            "synthetic"
          ],
          "type": "string"
        },
        "episode_id": {
          "pattern": "^ep_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "evidence_mnats": {
          "maximum": 100000,
          "minimum": -100000,
          "type": "integer"
        },
        "reasons": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "NO_VISIT_ON_CAMERA",
                  "VISIT_IN_PROGRESS",
                  "NOT_IN_TRUSTED_VENDORS",
                  "SECRECY_REQUEST",
                  "IRREVERSIBLE_PAYMENT",
                  "IDENTITY_MISMATCH",
                  "URGENCY",
                  "AUTHORITY_CLAIM",
                  "VERIFIED_CONTACT"
                ],
                "type": "string"
              },
              "plain_text": {
                "maxLength": 140,
                "type": "string"
              }
            },
            "required": [
              "code",
              "plain_text"
            ],
            "type": "object"
          },
          "maxItems": 5,
          "type": "array"
        },
        "recommended_next_step": {
          "enum": [
            "verify_via_official_number",
            "call_trusted_contact",
            "decline_politely",
            "no_action"
          ],
          "type": "string"
        },
        "risk_level": {
          "enum": [
            "low",
            "elevated",
            "high"
          ],
          "type": "string"
        }
      },
      "required": [
        "risk_level",
        "reasons",
        "recommended_next_step",
        "episode_id",
        "evidence_mnats",
        "data_origin"
      ],
      "type": "object"
    },
    "title": "Second opinion on a visitor or caller"
  },
  {
    "_meta": {
      "hearthward/class": "S+"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Look up an organization's official phone number from the household's trusted vendors or the curated directory. Never returns a number supplied by a visitor.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "organization_name": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "organization_name"
      ],
      "type": "object"
    },
    "name": "verify_organization_contact",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "advice": {
          "enum": [
            "call_official_number",
            "no_official_record"
          ],
          "type": "string"
        },
        "data_origin": {
          "enum": [
            "live",
            "synthetic"
          ],
          "type": "string"
        },
        "display_name": {
          "maxLength": 80,
          "type": "string"
        },
        "found": {
          "type": "boolean"
        },
        "official_phone_e164": {
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "type": "string"
        },
        "source": {
          "enum": [
            "trusted_vendors",
            "curated_directory",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "found",
        "source",
        "advice",
        "data_origin"
      ],
      "type": "object"
    },
    "title": "Find an organization's official number"
  },
  {
    "_meta": {
      "hearthward/class": "S+"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Explain the most recent alert in plain language: what was seen, what was said and how strong the evidence was. Read-only.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
