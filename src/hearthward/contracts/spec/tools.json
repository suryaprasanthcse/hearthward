          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "approve_on": {
              "enum": [
                "caregiver_phone",
                "elder_phone"
              ],
              "type": "string"
            },
            "challenge_id": {
              "pattern": "^chl_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "expires_at_ms": {
              "minimum": 0,
              "type": "integer"
            },
            "rules": {
              "items": {
                "pattern": "^HX-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              "maxItems": 12,
              "type": "array"
            },
            "spoken_hint": {
              "maxLength": 160,
              "type": "string"
            },
            "status": {
              "const": "PROOF_REQUIRED",
              "type": "string"
            }
          },
          "required": [
            "status",
            "challenge_id",
            "approve_on",
            "rules",
            "expires_at_ms",
            "spoken_hint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "rules": {
              "items": {
                "pattern": "^HX-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              "maxItems": 12,
              "type": "array"
            },
            "spoken_hint": {
              "maxLength": 160,
              "type": "string"
            },
            "status": {
              "const": "BLOCKED",
              "type": "string"
            }
          },
          "required": [
            "status",
            "rules",
            "spoken_hint"
          ],
          "type": "object"
        }
      ],
      "type": "object"
    },
    "title": "Dismiss an alert"
