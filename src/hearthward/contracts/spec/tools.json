                  "NOT_IN_TRUSTED_VENDORS",
                  "SECRECY_REQUEST",
                  "IRREVERSIBLE_PAYMENT",
                  "IDENTITY_MISMATCH",
                  "URGENCY",
                  "AUTHORITY_CLAIM",
                  "VERIFIED_CONTACT"
