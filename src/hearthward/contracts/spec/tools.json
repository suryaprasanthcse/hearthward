    "name": "dismiss_alert",
    "outputSchema": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "episode_id": {
              "pattern": "^ep_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "proof_hash": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
