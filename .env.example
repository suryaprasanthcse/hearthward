# HEARTHWARD gate variables (tools/pipeline.py ENV_RULES). Copy to .env and fill in; never commit .env.
# Values here stay empty or <placeholder>.

# Canonical MCP resource URI: https://<host>/mcp, no trailing slash; must match the Alexa+ add-on manifest exactly
HW_MCP_RESOURCE_URI=<https://mcp-api-host/mcp>
# OAuth 2.1 facade issuer (RFC 8414): https://<host>, no path, no trailing slash
HW_FACADE_ISSUER=<https://auth-api-host>
# Cognito user pool issuer: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
HW_COGNITO_ISSUER=<https://cognito-idp.region.amazonaws.com/user-pool-id>
# Cognito managed-login base URL, no path
HW_COGNITO_DOMAIN=<https://managed-login-domain>
# Cognito app client id used by Alexa+ account linking
HW_ALEXA_CLIENT_ID=<cognito-app-client-id>
# AWS region code, such as us-east-1
AWS_REGION=<region>
# DynamoDB table name for the hash-chained EventLedger
HW_LEDGER_TABLE=<ledger-table-name>
# KMS key ARN of the attestation signer (ECC_NIST_P256)
HW_ATTEST_KEY_ARN=<arn:aws:kms:region:account:key/key-id>
# IAM role ARN the broker assumes to apply proof-carrying S- actions
HW_BROKER_EXECUTOR_ROLE_ARN=<arn:aws:iam::account:role/name>
# WebAuthn relying party ID: the approval page's host name
HW_WEBAUTHN_RP_ID=<rp-host-name>
# Step Functions state machine ARN of the InterventionLadder
HW_LADDER_STATE_MACHINE_ARN=<arn:aws:states:region:account:stateMachine:name>
# S3 bucket (Object Lock, compliance mode) for Merkle anchors
HW_ANCHOR_BUCKET=<anchor-bucket-name>
