# mcp Fargate task. Build context: the repository root.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
RUN pip install --no-cache-dir "mcp==2.3.0" "pyjwt[crypto]" "cryptography" "starlette" "uvicorn" "jsonschema" \
    "rfc8785" "boto3"
WORKDIR /app
COPY src /app/src
RUN useradd --system --uid 10001 hearthward
USER hearthward
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "--factory", "hearthward.mcp.asgi:create", "--host", "0.0.0.0", "--port", "8080"]
